  <property name="styleSheet">
   <string>
    /* Fondo principal súper oscuro y limpio */
    QMainWindow { background-color: #0d1117; font-family: 'Segoe UI', Roboto, sans-serif; }
    
    /* Panel lateral simulando una 'tarjeta' moderna */
    QWidget#panel_controles { background-color: #161b22; border-radius: 12px; border: 1px solid #30363d; }
    
    /* Contenedor temporal de la gráfica para que no colapse el espacio */
    QWidget#contenedor_grafica { background-color: #0d1117; border: 2px dashed #30363d; border-radius: 12px; }
    
    /* Textos y títulos limpios */
    QLabel { color: #8b949e; font-size: 13px; font-weight: 500; }
    QLabel#lbl_titulo1, QLabel#lbl_titulo2, QLabel#lbl_titulo3 { color: #c9d1d9; font-size: 16px; font-weight: bold; margin-bottom: 5px; margin-top: 10px; }
    QLabel#label_teorica, QLabel#label_simulada { color: #58a6ff; font-size: 15px; font-weight: bold; }
    
    /* Inputs sin bordes toscos, estilo minimalista */
    QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox { background-color: #0d1117; color: #c9d1d9; padding: 8px 12px; border: 1px solid #30363d; border-radius: 6px; font-size: 14px; }
    QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus, QSpinBox:focus { border: 1px solid #58a6ff; }
    QComboBox::drop-down { border: none; }
    
    /* Botón principal (Call to action) azul vibrante */
    QPushButton#boton_calcular { background-color: #238636; color: white; padding: 12px; border-radius: 6px; font-weight: bold; font-size: 14px; border: none; }
    QPushButton#boton_calcular:hover { background-color: #2ea043; }
    
    /* Botón secundario discreto */
    QPushButton#boton_exportar { background-color: transparent; border: 1px solid #30363d; color: #8b949e; padding: 8px 16px; border-radius: 6px; font-weight: bold; }
    QPushButton#boton_exportar:hover { background-color: #30363d; color: #c9d1d9; }
   </string>
  </property>
