         <attribute name="horizontalHeaderLabels">
          <string>Teórico;Simulado;Diferencia</string>
         </attribute>
         <attribute name="verticalHeaderLabels">
          <string>Probabilidad;Media;Varianza;Desviación Est.;Tamaño Muestra</string>
         </attribute>
         <attribute name="horizontalHeaderStretchLastSection"><bool>true</bool></attribute>
