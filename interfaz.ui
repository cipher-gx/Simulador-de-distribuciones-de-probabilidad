    <width>1100</width>
    <height>680</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Simulador de Probabilidades</string>
  </property>
  <property name="styleSheet">
   <string>
    QMainWindow { background-color: #0d1117; font-family: 'Segoe UI', Roboto, sans-serif; }
    QWidget#panel_controles { background-color: #161b22; border-radius: 12px; border: 1px solid #30363d; }
    QWidget#contenedor_grafica { background-color: #0d1117; border: 2px dashed #30363d; border-radius: 12px; }
    QLabel { color: #8b949e; font-size: 13px; font-weight: 500; }
    QLabel#lbl_titulo1, QLabel#lbl_titulo2, QLabel#lbl_titulo3 { color: #c9d1d9; font-size: 16px; font-weight: bold; margin-bottom: 5px; margin-top: 10px; }
    QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox { background-color: #0d1117; color: #c9d1d9; padding: 8px 12px; border: 1px solid #30363d; border-radius: 6px; font-size: 14px; }
    QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus, QSpinBox:focus { border: 1px solid #58a6ff; }
    QComboBox::drop-down { border: none; }
    QPushButton#boton_calcular { background-color: #238636; color: white; padding: 12px; border-radius: 6px; font-weight: bold; font-size: 14px; border: none; }
    QPushButton#boton_calcular:hover { background-color: #2ea043; }
    QPushButton#boton_exportar { background-color: transparent; border: 1px solid #30363d; color: #8b949e; padding: 8px 16px; border-radius: 6px; font-weight: bold; }
    QPushButton#boton_exportar:hover { background-color: #30363d; color: #c9d1d9; }
    QTableWidget { background-color: #0d1117; color: #c9d1d9; gridline-color: #30363d; border: 1px solid #30363d; border-radius: 6px; font-size: 13px; }
    QHeaderView::section { background-color: #161b22; color: #8b949e; border: 1px solid #30363d; font-weight: bold; padding: 4px; }
    QTableWidget::item { padding: 5px; }
   </string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QHBoxLayout" name="horizontalLayout" stretch="0,1">
    <property name="spacing"><number>20</number></property>
    <property name="leftMargin"><number>20</number></property>
    <property name="topMargin"><number>20</number></property>
    <property name="rightMargin"><number>20</number></property>
    <property name="bottomMargin"><number>20</number></property>
    <item>
     <widget class="QWidget" name="panel_controles" native="true">
      <property name="sizePolicy">
       <sizepolicy hsizetype="Fixed" vsizetype="Expanding">
        <horstretch>0</horstretch>
        <verstretch>0</verstretch>
       </sizepolicy>
      </property>
      <property name="minimumSize"><size><width>420</width><height>0</height></size></property>
      <property name="maximumSize"><size><width>460</width><height>16777215</height></size></property>
      <layout class="QVBoxLayout" name="verticalLayout">
       <item><widget class="QLabel" name="lbl_titulo1"><property name="text"><string>Distribución</string></property></widget></item>
       <item>
        <widget class="QComboBox" name="combo_distribuciones">
         <item><property name="text"><string>Normal</string></property></item>
         <item><property name="text"><string>Exponencial</string></property></item>
         <item><property name="text"><string>Uniforme</string></property></item>
         <item><property name="text"><string>Bernoulli</string></property></item>
         <item><property name="text"><string>Binomial</string></property></item>
         <item><property name="text"><string>Geométrica</string></property></item>
         <item><property name="text"><string>Hipergeométrica</string></property></item>
         <item><property name="text"><string>Poisson</string></property></item>
        </widget>
       </item>
       <item>
        <widget class="QStackedWidget" name="paginas_variables">
         <property name="currentIndex"><number>0</number></property>
         <property name="maximumSize"><size><width>16777215</width><height>120</height></size></property>
         <widget class="QWidget" name="page_normal">
          <layout class="QFormLayout" name="formLayout_1">
           <item row="0" column="0"><widget class="QLabel" name="lbl_mu"><property name="text"><string>Media (μ):</string></property></widget></item>
           <item row="0" column="1"><widget class="QDoubleSpinBox" name="spin_media"><property name="minimum"><double>-10000</double></property><property name="maximum"><double>10000</double></property></widget></item>
           <item row="1" column="0"><widget class="QLabel" name="lbl_sigma"><property name="text"><string>Desviación (σ):</string></property></widget></item>
           <item row="1" column="1"><widget class="QDoubleSpinBox" name="spin_desviacion"><property name="minimum"><double>0.0001</double></property><property name="value"><double>1</double></property><property name="maximum"><double>10000</double></property></widget></item>
          </layout>
         </widget>
         <widget class="QWidget" name="page_exponencial">
          <layout class="QFormLayout" name="formLayout_2">
           <item row="0" column="0"><widget class="QLabel" name="lbl_lam1"><property name="text"><string>Tasa (λ):</string></property></widget></item>
           <item row="0" column="1"><widget class="QDoubleSpinBox" name="spin_lambda"><property name="minimum"><double>0.0001</double></property><property name="value"><double>1</double></property><property name="maximum"><double>10000</double></property></widget></item>
          </layout>
         </widget>
         <widget class="QWidget" name="page_uniforme">
          <layout class="QFormLayout" name="formLayout_3">
           <item row="0" column="0"><widget class="QLabel" name="lbl_a"><property name="text"><string>Límite Inf. (a):</string></property></widget></item>
           <item row="0" column="1"><widget class="QDoubleSpinBox" name="spin_a"><property name="minimum"><double>-10000</double></property><property name="maximum"><double>10000</double></property></widget></item>
           <item row="1" column="0"><widget class="QLabel" name="lbl_b"><property name="text"><string>Límite Sup. (b):</string></property></widget></item>
           <item row="1" column="1"><widget class="QDoubleSpinBox" name="spin_b"><property name="minimum"><double>-10000</double></property><property name="maximum"><double>10000</double></property><property name="value"><double>1</double></property></widget></item>
          </layout>
         </widget>
         <widget class="QWidget" name="page_bernoulli">
          <layout class="QFormLayout" name="formLayout_4">
           <item row="0" column="0"><widget class="QLabel" name="lbl_p1"><property name="text"><string>Prob. Éxito (p):</string></property></widget></item>
           <item row="0" column="1"><widget class="QDoubleSpinBox" name="spin_p_ber"><property name="minimum"><double>0</double></property><property name="maximum"><double>1</double></property><property name="singleStep"><double>0.01</double></property><property name="value"><double>0.5</double></property></widget></item>
          </layout>
         </widget>
         <widget class="QWidget" name="page_binomial">
          <layout class="QFormLayout" name="formLayout_5">
           <item row="0" column="0"><widget class="QLabel" name="lbl_n1"><property name="text"><string>Ensayos (n):</string></property></widget></item>
           <item row="0" column="1"><widget class="QSpinBox" name="spin_n_bin"><property name="minimum"><number>1</number></property><property name="maximum"><number>10000</number></property><property name="value"><number>10</number></property></widget></item>
           <item row="1" column="0"><widget class="QLabel" name="lbl_p2"><property name="text"><string>Prob. Éxito (p):</string></property></widget></item>
           <item row="1" column="1"><widget class="QDoubleSpinBox" name="spin_p_bin"><property name="minimum"><double>0</double></property><property name="maximum"><double>1</double></property><property name="singleStep"><double>0.01</double></property><property name="value"><double>0.5</double></property></widget></item>
          </layout>
         </widget>
         <widget class="QWidget" name="page_geometrica">
          <layout class="QFormLayout" name="formLayout_6">
           <item row="0" column="0"><widget class="QLabel" name="lbl_p3"><property name="text"><string>Prob. Éxito (p):</string></property></widget></item>
           <item row="0" column="1"><widget class="QDoubleSpinBox" name="spin_p_geo"><property name="minimum"><double>0.0001</double></property><property name="maximum"><double>1</double></property><property name="singleStep"><double>0.01</double></property><property name="value"><double>0.5</double></property></widget></item>
          </layout>
         </widget>
         <widget class="QWidget" name="page_hipergeometrica">
          <layout class="QFormLayout" name="formLayout_7">
           <item row="0" column="0"><widget class="QLabel" name="lbl_N"><property name="text"><string>Población (N):</string></property></widget></item>
           <item row="0" column="1"><widget class="QSpinBox" name="spin_N_pob"><property name="minimum"><number>1</number></property><property name="maximum"><number>100000</number></property><property name="value"><number>100</number></property></widget></item>
           <item row="1" column="0"><widget class="QLabel" name="lbl_K"><property name="text"><string>Éxitos Pob. (K):</string></property></widget></item>
           <item row="1" column="1"><widget class="QSpinBox" name="spin_K_exitos"><property name="minimum"><number>0</number></property><property name="maximum"><number>100000</number></property><property name="value"><number>20</number></property></widget></item>
           <item row="2" column="0"><widget class="QLabel" name="lbl_n2"><property name="text"><string>Muestra (n):</string></property></widget></item>
           <item row="2" column="1"><widget class="QSpinBox" name="spin_n_muestra"><property name="minimum"><number>1</number></property><property name="maximum"><number>100000</number></property><property name="value"><number>10</number></property></widget></item>
          </layout>
         </widget>
         <widget class="QWidget" name="page_poisson">
          <layout class="QFormLayout" name="formLayout_8">
           <item row="0" column="0"><widget class="QLabel" name="lbl_lam2"><property name="text"><string>Promedio (λ):</string></property></widget></item>
           <item row="0" column="1"><widget class="QDoubleSpinBox" name="spin_lam_poi"><property name="minimum"><double>0.0001</double></property><property name="value"><double>1</double></property><property name="maximum"><double>10000</double></property></widget></item>
          </layout>
         </widget>
        </widget>
       </item>
       <item><widget class="QLabel" name="lbl_titulo2"><property name="text"><string>Parámetros de Simulación</string></property></widget></item>
       <item><widget class="QLabel" name="lbl_exp"><property name="text"><string>Expresión Matemática (ej. 7 &lt; X &lt; 9):</string></property></widget></item>
       <item><widget class="QLineEdit" name="input_expresion"><property name="placeholderText"><string>Ingresa el límite...</string></property></widget></item>
       <item><widget class="QLabel" name="lbl_iter"><property name="text"><string>Tamaño de Muestra (Iteraciones):</string></property></widget></item>
       <item><widget class="QSpinBox" name="spin_iteraciones"><property name="minimum"><number>1</number></property><property name="maximum"><number>5000000</number></property><property name="value"><number>100000</number></property></widget></item>
       <item><widget class="QPushButton" name="boton_calcular"><property name="text"><string>Ejecutar Simulación</string></property><property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property></widget></item>
